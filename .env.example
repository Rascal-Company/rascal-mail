# Supabase - Rascal AI (authentication only)
NEXT_PUBLIC_AUTH_SUPABASE_URL=https://your-rascal-ai-project.supabase.co
NEXT_PUBLIC_AUTH_SUPABASE_ANON_KEY=your-rascal-ai-anon-key

# Airtable - Application data (demo version)
# WARNING: These should be server-side only for production!
# For demo prototype, these can be NEXT_PUBLIC_ but API keys will be exposed in browser
# TODO: Move to server-side API routes before production deployment
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

# SendGrid (disabled in demo version)
SENDGRID_API_KEY=SG.your-sendgrid-key

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
